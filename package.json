{
  "name": "mern-messaging-platform",
  "version": "1.0.0",
  "description": "Complete MERN Stack Messaging Application with Authentication, User Dashboard & Realtime Chat",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "dev": "node start-dev.js",
    "seed": "npm --prefix server run seed",
    "predeploy": "npm --prefix client run build",
    "deploy": "gh-pages -d client/dist"
  },
  "keywords": [
    "mern",
    "chat",
    "realtime",
    "react",
    "express",
    "mongodb"
  ],
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
